#include <iostream>
#include <queue>
using namespace std;
queue<int> q;
void push(int value)
{
    int n = q.size();
    q.push(value);
    for (int i = 0; i < n; i++)
    {
        q.push(q.front());
        q.pop();
    }
    cout << "Element pushed\n";
}
void pop()
{
    if (q.empty())
    {
        cout << "Stack is Empty\n";
    }
    else
    {
        cout << "Popped element: " << q.front() << endl;
        q.pop();
    }
}

void display()
{
    if (q.empty())
    {
        cout << "Stack is Empty\n";
        return;
    }
    queue<int> temp = q;
    cout << "Stack: ";
    while (!temp.empty())
    {
        cout << temp.front() << " ";
        temp.pop();
    }
    cout << endl;
}

int main()
{
    int choice, value;

    do
    {
        cout << "\n--- STACK USING ONE QUEUE ---\n";
        cout << "1. Push\n";
        cout << "2. Pop\n";
        cout << "3. Display\n";
        cout << "4. Exit\n";

        cout << "Enter choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            cout << "Enter value: ";
            cin >> value;
            push(value);
            break;
        case 2:
            pop();
            break;
        case 3:
            display();
            break;
        case 4:
            cout << "Program ended\n";
            break;

        default:
            cout << "Invalid choice\n";
        }

    } while (choice != 4);

    return 0;
}
