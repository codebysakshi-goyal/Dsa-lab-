#include <iostream>
using namespace std;

int q[100], front = -1, rear = -1, n = 5;

int main(){
    int ch, val;
    while(1){
        cout<<"\n1.Enqueue 2.Dequeue 3.Display 4.Peek 5.Exit\n";
        cout<<"Choice: ";
        cin>>ch;

        if(ch==1){
            if((front==0 && rear==n-1) || (rear+1)%n==front){
                cout<<"Full\n";
            }
            else{
                cout<<"Enter val: ";
                cin>>val;
                if(front==-1) front=0;
                rear = (rear+1)%n;
                q[rear]=val;
            }
        }
        else if(ch==2){
            if(front==-1) cout<<"Empty\n";
            else{
                cout<<q[front]<<" removed\n";
                if(front==rear) front=rear=-1;
                else front = (front+1)%n;
            }
        }
        else if(ch==3){
            if(front==-1) cout<<"Empty\n";
            else{
                int i=front;
                while(1){
                    cout<<q[i]<<" ";
                    if(i==rear) break;
                    i=(i+1)%n;
                }
                cout<<"\n";
            }
        }
        else if(ch==4){
            if(front==-1) cout<<"Empty\n";
            else cout<<q[front]<<"\n";
        }
        else if(ch==5) break;
    }
}
