#include <iostream>
using namespace std;

#define SIZE 100

int main()
{
    int n;
    int queueArr[SIZE];
    cout << "Enter number of elements: ";
    cin >> n;
    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> queueArr[i];
    }
    int half = n / 2;
    cout << "Interleaved Queue: ";
    for (int i = 0; i < half; i++)
    {
        cout << queueArr[i] << " ";
        cout << queueArr[i + half] << " ";
    }

    return 0;
}
