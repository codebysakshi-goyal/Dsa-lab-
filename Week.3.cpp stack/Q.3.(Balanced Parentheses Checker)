#include <iostream>
#include <stack>
#include <string>
using namespace std;

bool isBalanced(string expr) {
    stack<char> s;

    for (int i = 0; i < expr.length(); i++) {
        char ch = expr[i];
        if (ch == '(' || ch == '{' || ch == '[') {
           s.push(ch);
        }
        else if (ch == ')' || ch == '}' || ch == ']') {        
            if (s.empty()) {
                return false;
            }
            char topChar = s.top();
            if ((ch == ')' && topChar == '(') ||
                (ch == '}' && topChar == '{') ||
                (ch == ']' && topChar == '[')) {
                s.pop(); 
            } else {
                return false; 
            }
        }
    }
    return s.empty();
}

int main() {
    string expr = "{()}[]";

    if (isBalanced(expr)) {
        cout << expr << " is Balanced" << endl;
    } else {
        cout << expr << " is Not Balanced" << endl;
    }
    return 0;
}
