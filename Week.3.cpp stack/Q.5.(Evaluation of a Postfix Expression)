#include <iostream>
#include <stack>
#include <string>
using namespace std;

int evaluatePostfix(string expr) {
    stack<int> s;

    for (int i = 0; i < expr.length(); i++) {
        char ch = expr[i];
        if (ch >= '0' && ch <= '9') {
            s.push(ch - '0'); 
        } 
        else {
            int val2 = s.top(); s.pop();
            int val1 = s.top(); s.pop(); 

            switch (ch) {
                case '+': s.push(val1 + val2); break;
                case '-': s.push(val1 - val2); break;
                case '*': s.push(val1 * val2); break;
                case '/': s.push(val1 / val2); break;
            }
        }
    }
    return s.top(); 
}

int main() {
    string expr = "231*+9-"; 
    cout << "Result of evaluation: " << evaluatePostfix(expr) << endl;
    return 0;
}
