#include <iostream>
#include <unordered_set>
using namespace std;

int countDistinct(int arr[], int n) {
    unordered_set<int> distinct;

    for (int i = 0; i < n; i++)
        distinct.insert(arr[i]);

    return static_cast<int>(distinct.size());
}

int main() {
    int arr[] = {10, 20, 10, 30, 20, 40, 50, 40};
    int n = sizeof(arr) / sizeof(arr[0]);

    cout << "Total distinct elements: "
         << countDistinct(arr, n) << endl;

    return 0;
}
// Average Time: O(n), Average Space: O(n)
